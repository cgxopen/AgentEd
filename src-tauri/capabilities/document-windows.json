{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "document-windows",
  "description": "The windows opened after the main one on macOS (#559), with the permissions of the main window and no other",
  "platforms": ["macOS"],
  "windows": ["doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    "shell:default"
  ]
}
